# Generated interactively by ./install.sh. Keep .env private (chmod 600).
PORT=8080
BIND_ADDRESS=127.0.0.1
APP_URL=http://localhost:8080
SECURE_COOKIES=false
# Internal proxy trust: API trusts the web container; web trusts the host gateway.
# Change all values together if this subnet conflicts with an existing Docker network.
DOCKER_SUBNET=172.30.251.0/24
DOCKER_GATEWAY=172.30.251.1
API_IP=172.30.251.2
WEB_IP=172.30.251.3
DB_IP=172.30.251.4
# Set to DOCKER_GATEWAY for host nginx HTTPS; 127.0.0.1 disables edge trust.
EDGE_PROXY_IP=127.0.0.1
DATA_DIRECTORY=/var/lib/secrets-hub
# Random URL-safe database password, generated by installer. No default value.
DB_PASSWORD=
